{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pages-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler",
        "pages",
        "dev",
        "--port",
        "8788"
      ],
      "port": 8788
    },
    {
      "name": "static-public",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8799",
        "--directory",
        "public"
      ],
      "port": 8799
    }
  ]
}